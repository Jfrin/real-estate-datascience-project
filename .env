# Sets the Docker Compose project name for this folder.
# All containers, networks, and volumes get prefixed with this name
# instead of the folder name, so this stack won't collide with other
# projects on the same machine.
#
# To run a second, independent copy of this stack (e.g. for testing),
# copy this whole folder elsewhere and change this value — but note
# you'll also need to change the host ports below in docker-compose.yml
# if you want BOTH copies running AT THE SAME TIME (see README).
COMPOSE_PROJECT_NAME=realestate
